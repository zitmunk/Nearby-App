{
  "expo": {
    "name": "mi-app-chat",
    "slug": "mi-app-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "miappchat",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/expo.icon",
      "entitlements": {
        "aps-environment": "development"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Esta aplicación requiere tu ubicación para compartirla en el chat.",
        "NSMicrophoneUsageDescription": "Esta aplicación requiere acceso al micrófono para enviar notas de voz.",
        "NSPhotoLibraryUsageDescription": "Esta aplicación requiere acceso a tus fotos para enviarlas en el chat.",
        "NSCameraUsageDescription": "Esta aplicación requiere acceso a la cámara para tomar fotos."
      },
      "bundleIdentifier": "com.zitmunk.miappchat"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },

      "googleServicesFile": "./google-services.json",

      "predictiveBackGestureEnabled": false,

      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],

      "package": "com.zitmunk.miappchat"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Esta aplicación requiere tu ubicación para mostrarte usuarios cercanos y compartir tu posición en el chat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La aplicación necesita acceso a tus fotos para enviarlas en el chat."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-image"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "7bc385e4-e611-46ad-bcb7-6fb4f7b3db9d"
      }
    }
  }
}